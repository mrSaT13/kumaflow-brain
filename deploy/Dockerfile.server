FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    ONNXRUNTIME_INTRA_OP_THREADS=1

WORKDIR /app

# Системные зависимости для psycopg2, librosa/soundfile и healthcheck.
# tzdata нужен для APP_TIMEZONE (IANA-имена вида Europe/Samara).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    libsndfile1 \
    libpq-dev \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Сначала только зависимости — слой кэшируется, пока не меняется requirements.
COPY server/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt
# CLAP модель печём В ОБРАЗ (Xenova quantized text+audio ~165МБ, build-cache):
# на сервере ничего качать не надо — всё работает из коробки.
# Бинарники в git не кладём (models/ в .gitignore/.dockerignore) — качаем
# с HuggingFace при сборке. Пустой mount ./deploy/models НЕ делать:
# он затенит запечённое (см. docker-compose.yml).
# ВАЖНО: download_clap падает с exit 1 если модели нет — сборка КРАСНЕЕТ,
# а не запекает молча пустой образ того же размера (было с laion/*: там
# только pytorch .bin, ONNX нет вообще).
# ARG ниже — ручной cache-buster: если слой закэшировал пропуск без сети,
# поднимите значение и пересоберите, иначе кэш будет переиспользовать промах.
ARG CLAP_BUSTER=3
COPY server/ml /app/ml
RUN python -m ml.download_clap && ls -lh /app/ml/models && echo "--- onnx:" && ls -l /app/ml/models/*.onnx

# Затем код. Мусор (.venv, *.db, логи, кэш) отсекается корневым .dockerignore.
COPY server/app /app/app
COPY server/alembic.ini /app/alembic.ini

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
