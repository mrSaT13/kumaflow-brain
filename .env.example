# Ключи и адреса образов для docker-compose.yml + локальной разработки.
# Скопируй:  cp .env.example .env   — и впиши свои значения.
# ВАЖНО: этот файл не коммитить, если внёс реальные секреты (.env уже в .gitignore).

# --- GHCR-образы (собирает CI при пуше в main) ---
# Формат: ghcr.io/<github-owner>/<repo>-backend:latest
# Узнать точные имена можно во вкладке Packages твоего репозитория после первого прогона CI.
BACKEND_IMAGE=ghcr.io/mrsat13/kumaflow-brain-backend:latest
WEB_IMAGE=ghcr.io/mrsat13/kumaflow-brain-web:latest
BRIDGE_IMAGE=ghcr.io/mrsat13/kumaflow-brain-bridge:latest

# --- Порты на хосте ---
API_PORT=8000
WEB_PORT=3000
BRIDGE_PORT=8001
NAVIDROME_PORT=4533

# --- Postgres / Redis ---
POSTGRES_USER=kumaflow
POSTGRES_PASSWORD=CHANGE_ME_kumaflow
POSTGRES_DB=kumaflow

# --- Приложение ---
APP_NAME=KumaFlow Brain
APP_VERSION=0.1.0
ENV=prod
LOG_LEVEL=INFO
# Если фронт откроешь не с localhost — добавь свой origin через запятую в JSON-списке,
# например: ["http://localhost:3000","http://<ip-или-домен-сервера>:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# --- Медиа-сервер ---
MEDIA_SERVER_TYPE=navidrome
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=changeme
# Папка с музыкой для профиля --profile media (только если Navidrome крутится рядом)
MUSIC_DIR=./deploy/music

# --- AI ---
AI_PROVIDER=NONE
OPENAI_API_KEY=
OPENAI_SERVER_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL_NAME=gpt-4o-mini
OLLAMA_SERVER_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1
# Ollama Cloud: ключ с https://ollama.com/settings → API keys
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=llama3.1

CLAP_ENABLED=true
USE_GPU_CLUSTERING=false

# --- Yandex Music (неофициальное API) ---
YANDEX_MUSIC_TOKEN=
YANDEX_MUSIC_ENABLED=false

# --- Тексты песен ---
LYRICS_PROVIDERS=["lyrics.ovh","musixmatch"]
LYRICS_USER_AGENT=Mozilla/5.0 (compatible; KumaFlowBrain/0.1)

# --- Мост метаданных (MusicBrainz / Last.fm, опционально) ---
# Сам адрес моста задаётся в веб-UI (Настройки → Мост), здесь — только дефолт и ключи.
BRIDGE_URL=http://bridge:8001
BRIDGE_ENABLED=false
# Ключ Last.fm: https://www.last.fm/api/account/create (без него — только MusicBrainz)
LASTFM_API_KEY=
BRIDGE_USER_AGENT=KumaFlowBridge/0.1
BRIDGE_CACHE_TTL_HOURS=24

# --- Фронт (серверный прокси на backend, менять обычно не нужно) ---
KUMAFLOW_API_URL=http://backend:8000
