# KumaFlow Brain — env
# Скопируй в server/.env и подставь свои значения.

APP_NAME=KumaFlow Brain
APP_VERSION=0.1.0
ENV=dev
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kumaflow
POSTGRES_PASSWORD=kumaflow
POSTGRES_DB=kumaflow

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Media server
MEDIA_SERVER_TYPE=navidrome
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=changeme

# AI
AI_PROVIDER=NONE
OPENAI_API_KEY=
OPENAI_SERVER_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL_NAME=gpt-4o-mini
OLLAMA_SERVER_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1

# Ollama Cloud (https://ollama.com)
# Ключ: https://ollama.com/settings  →  "API keys"
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=llama3.1

CLAP_ENABLED=true
# Аудио-эмбеддинги CPU (opt-in, динозавр-friendly). false = поведение 1в1 как раньше.
# true + server/ml/models/*audio*.onnx = гибрид в похожих/волне, иначе автофолбек на librosa.
CLAP_AUDIO_ENABLED=false
CLAP_AUDIO_THREADS=1
CLAP_AUDIO_WEIGHT=0.7
USE_GPU_CLUSTERING=false

# Bridge (метаданные MusicBrainz / Last.fm)
# Обычно задаётся из веб-UI (Настройки → Мост), env — только дефолт.
BRIDGE_URL=
BRIDGE_ENABLED=false

# Sonic-анализ: где лежат аудиофайлы для worker'а.
# Та же папка, что примонтирована в Navidrome (только чтение).
# Если пусто — worker тянет аудио стримом из Navidrome через Subsonic API.
MUSIC_DIR=
# Сколько секунд каждого трека анализировать (моно 22050 Гц)
ANALYSIS_SAMPLE_SECONDS=90
# Сколько непроанализированных треков брать за один прогон (0 — все сразу)
ANALYSIS_MAX_TRACKS_PER_RUN=0  # 0 = все за один прогон (раньше 200 — останавливалось)
# Запись mood/genre/key/bpm обратно в файлы (только если MUSIC_DIR примонтирован rw)
MUTAGEN_WRITEBACK=false
MUTAGEN_WRITEBACK_BACKUP=false
YANDEX_MUSIC_THROTTLE_SEC=1.2
YANDEX_MUSIC_CACHE_TTL_HOURS=72

# Yandex Music (unofficial API)
YANDEX_MUSIC_TOKEN=
YANDEX_MUSIC_ENABLED=false

# Lyrics
LYRICS_PROVIDERS=["lyrics.ovh","musixmatch"]
LYRICS_USER_AGENT=Mozilla/5.0 (compatible; KumaFlowBrain/0.1)
