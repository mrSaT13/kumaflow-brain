# KumaFlow Bridge — env (пример)
# Локальный запуск:  cd bridge && cp .env.example .env && uvicorn main:app --port 8001
# В compose переменные берутся из корневого .env (см. BRIDGE_* и LASTFM_API_KEY).

PORT=8001

# Last.fm без ключа работает в урезанном режиме (только MusicBrainz).
# Ключ: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# MusicBrainz требует осмысленный User-Agent
BRIDGE_USER_AGENT=KumaFlowBridge/0.1 ( https://github.com/mrSaT13/kumaflow-brain )

# Сколько часов хранить ответы в памяти
BRIDGE_CACHE_TTL_HOURS=24
